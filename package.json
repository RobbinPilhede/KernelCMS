{
  "name": "kernelcms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "kernel": "tsx packages/cli/src/bin.ts",
    "admin": "pnpm --filter @kernel/admin-app dev",
    "example:migrate": "tsx packages/cli/src/bin.ts migrate --config examples/blog/kernel.config.ts",
    "example:seed": "tsx packages/cli/src/bin.ts seed --config examples/blog/kernel.config.ts",
    "example:dev": "tsx packages/cli/src/bin.ts dev --config examples/blog/kernel.config.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^10.0.1",
    "@kernel/richtext": "workspace:*",
    "@kernel/storage": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.4",
    "tsup": "^8.3.5",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
