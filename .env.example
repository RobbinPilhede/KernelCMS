# KernelCMS environment variables.
# Copy to `.env` and fill in. Never commit your real `.env`.

# --- Core ---------------------------------------------------------------------
# Secret used to sign auth tokens. REQUIRED in any non-local environment.
# Generate one, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KERNEL_SECRET=

# Optional trusted system API key. Requests with `Authorization: Bearer <key>` run as a
# trusted caller that bypasses access control. Leave empty to disable.
KERNEL_API_KEY=

# Log level: debug | info | warn | error
KERNEL_LOG_LEVEL=info

# HTTP port for the server / CLI dev command.
PORT=3000

# --- Database -----------------------------------------------------------------
# With no DATABASE_URL the example falls back to a local SQLite file.
# Set this to use PostgreSQL instead.
# DATABASE_URL=postgres://user:password@localhost:5432/kernelcms

# --- Storage (Cloudflare R2 / S3), optional ----------------------------------
# R2_BUCKET=
# R2_ENDPOINT=
# R2_KEY=
# R2_SECRET=
# R2_PUBLIC_URL=

# --- Email (for password reset / verification), optional ---------------------
# Used by an HTTP email adapter such as Resend. Without one, mail is logged to console.
# RESEND_API_KEY=
# EMAIL_FROM="KernelCMS <no-reply@yourdomain.com>"

# --- OAuth providers, optional ------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
