{
  "name": "kernelcms",
  "version": "0.36.0",
  "description": "The TanStack-native, adapter-based, end-to-end type-safe headless CMS. Config-as-code, self-hosted.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobbinPilhede/KernelCMS.git",
    "directory": "packages/kernelcms"
  },
  "homepage": "https://kernelcms.com",
  "bugs": "https://github.com/RobbinPilhede/KernelCMS/issues",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "cms",
    "headless-cms",
    "headless",
    "content-management",
    "tanstack",
    "typescript",
    "sqlite",
    "self-hosted"
  ],
  "bin": {
    "kernel": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "default": "./dist/sqlite.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./richtext": {
      "types": "./dist/richtext.d.ts",
      "default": "./dist/richtext.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./graphql": {
      "types": "./dist/graphql.d.ts",
      "default": "./dist/graphql.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./plugin-seo": {
      "types": "./dist/plugin-seo.d.ts",
      "default": "./dist/plugin-seo.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./visual-editing": {
      "types": "./dist/visual-editing.d.ts",
      "default": "./dist/visual-editing.js"
    },
    "./visual-editing/react": {
      "types": "./dist/visual-editing/react.d.ts",
      "default": "./dist/visual-editing/react.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/sync-readme.mjs && pnpm --filter @kernel/admin-app build && node ../server/scripts/embed-admin.mjs && tsup && tsup --config tsup.visual-editing.config.ts",
    "prepublishOnly": "node scripts/sync-readme.mjs && pnpm --filter @kernel/admin-app build && node ../server/scripts/embed-admin.mjs && tsup && tsup --config tsup.visual-editing.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "graphql": "^16.9.0",
    "pg": "^8.13.1"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.0.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kernel/core": "workspace:*",
    "@kernel/db": "workspace:*",
    "@kernel/db-postgres": "workspace:*",
    "@kernel/db-sqlite": "workspace:*",
    "@kernel/server": "workspace:*",
    "@kernel/client": "workspace:*",
    "@kernel/richtext": "workspace:*",
    "@kernel/storage": "workspace:*",
    "@kernel/graphql": "workspace:*",
    "@kernel/testing": "workspace:*",
    "@kernel/plugin-seo": "workspace:*",
    "@kernel/visual-editing": "workspace:*",
    "@kernel/mcp": "workspace:*",
    "@kernel/cli": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "tsup": "^8.3.5"
  }
}
