{
  "name": "@kernel/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "kernel": "./src/bin.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@kernel/core": "workspace:*",
    "@kernel/db-sqlite": "workspace:*",
    "@kernel/server": "workspace:*"
  }
}
